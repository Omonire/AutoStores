/* STEP 1: Design tokens live in $variables so colours can be changed once. */
$accent: #8f6bff;
$ink: #0b0a13;
$surface: #151322;
$muted: #a7a3bb;

/* STEP 2: The bang syntax publishes $accent as a CSS custom property. */
:root {
  --accent: $accent!;
}

/* STEP 3: Border-box sizing makes widths predictable. */
* {
  box-sizing: border-box;
}

/* STEP 4: Base page typography; bg and ff are FSCSS shorthands. */
body {
  bg: $ink!;
  color: #f7f5ff;
  ff: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  margin: 0;
  line-height: 1.6;
}

/* STEP 5: Links inherit colour; decoration is handled per component. */
a {
  color: inherit;
  text-decoration: none;
}

/* STEP 6: Header sits above the page with a subtle divider. */
.site-header {
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  padding: 18px 0;
}

/* STEP 7: Flex nav keeps the brand left and links right. */
.nav {
  align-items: center;
  display: flex;
  gap: 24px;
  justify-content: space-between;
  margin: 0 auto;
  max-width: 1120px;
  padding: 0 4vw;
}

/* STEP 8: Brand typography. */
.brand {
  font-size: 20px;
  font-weight: 800;
  letter-spacing: -0.04em;
}

/* STEP 8.1: Accent the plus sign so the logo has a focal point. */
.brand span {
  color: var(--accent);
}

/* STEP 9: Muted nav links with hover feedback. */
.nav-links {
  color: $muted!;
  display: flex;
  font-size: 14px;
  gap: 22px;
}

.nav-links a:hover {
  color: #fff;
}

/* STEP 10: Main content column is centred and capped at 1120px. */
.container {
  margin: 0 auto;
  max-width: 1120px;
  padding: 0 4vw 64px;
}

/* STEP 11: Hero gets generous breathing room above the cards. */
.hero {
  max-width: 780px;
  padding: 72px 0 48px;
}

/* STEP 12: Small uppercase label above the headline. */
.eyebrow {
  color: var(--accent);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.22em;
  margin: 0;
  text-transform: uppercase;
}

/* STEP 13: Fluid headline scales from phones to desktops. */
.hero h1 {
  font-size: clamp(40px, 7vw, 76px);
  letter-spacing: -0.05em;
  line-height: 1.02;
  margin: 16px 0;
}

/* STEP 14: Gradient text is clipped to the glyphs. */
.gradient {
  background: linear-gradient(100deg, #c4b5fd, #67e8f9);
  background-clip: text;
  -webkit-background-clip: text;
  color: transparent;
}

/* STEP 15: Supporting copy uses the muted token. */
.lead {
  color: $muted!;
  font-size: 18px;
  margin: 0;
  max-width: 620px;
}

/* STEP 16: Button row wraps on narrow screens. */
.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 28px;
}

/* STEP 17: Primary button uses FSCSS bg, fw, px, py and rounded shorthands. */
.btn {
  align-items: center;
  bg: $accent!;
  color: #fff;
  display: inline-flex;
  fw: 700;
  gap: 8px;
  px: 20px;
  py: 12px;
  rounded: 12px;
}

/* STEP 17.1: Secondary variant overrides the background only. */
.btn.secondary {
  bg: #221f33;
  color: #fff;
}

/* STEP 18: Responsive card grid without media queries. */
.card-grid {
  display: grid;
  gap: 16px;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
}

/* STEP 19: Card uses stack to create a vertical flex column with a gap. */
.card {
  bg: $surface!;
  border: 1px solid rgba(255, 255, 255, 0.07);
  px: 24px;
  py: 22px;
  rounded: 18px;
  stack: 8px;
}

/* STEP 19.1: Reset heading margins inside cards. */
.card h2 {
  font-size: 18px;
  margin: 0;
}

/* STEP 19.2: Card body copy stays smaller and muted. */
.card p {
  color: $muted!;
  font-size: 14px;
  margin: 0;
}

/* STEP 20: Inline code gets a soft purple chip. */
code {
  background: rgba(143, 107, 255, 0.14);
  border-radius: 6px;
  color: #ddd6fe;
  font-size: 0.9em;
  padding: 2px 6px;
}

/* STEP 21: Status pill confirms the server is alive. */
.status {
  align-items: center;
  bg: #12251d;
  color: #86efac;
  display: inline-flex;
  font-size: 13px;
  fw: 700;
  gap: 8px;
  margin-top: 32px;
  px: 14px;
  py: 8px;
  rounded: 999px;
}

/* STEP 21.1: Small green dot inside the status pill. */
.dot {
  bg: #4ade80;
  border-radius: 50%;
  height: 8px;
  width: 8px;
}

/* STEP 22: Footer closes the page with the same muted tone. */
.site-footer {
  border-top: 1px solid rgba(255, 255, 255, 0.08);
  color: $muted!;
  font-size: 13px;
  padding: 24px 0;
  text-align: center;
}

/* STEP 23: Motion is opt-in and respects the user's OS preference. */
@media (prefers-reduced-motion: no-preference) {
  .btn {
    transition: transform 0.2s ease, filter 0.2s ease;
  }

  .btn:hover {
    filter: brightness(1.08);
    transform: translateY(-2px);
  }
}

/* STEP 1: Brand tokens. FSCSS variables are the single source of truth for the UI. */
$accent: #f68b1e;
$accent-dark: #d96c0b;
$accent-soft: #fff1e3;
$ink: #171717;
$cream: #fff8f1;
$sand: #f4f0ea;
$gold: #c99700;
$muted: #6b6560;
$white: #ffffff;

/* STEP 2: Publish tokens as CSS variables for gradients, shadows and runtime tweaks. */
:root {
  --accent: $accent!;
  --accent-dark: $accent-dark!;
  --accent-soft: $accent-soft!;
  --ink: $ink!;
  --cream: $cream!;
  --gold: $gold!;
  --muted: $muted!;
  --white: $white!;
  --shadow-luxe: 0 30px 80px rgba(23, 23, 23, 0.12);
  --shadow-float: 0 18px 50px rgba(246, 139, 30, 0.24);
  --gradient-gold: linear-gradient(105deg, #f68b1e 0%, #ffc63d 52%, #f68b1e 100%);
}

/* STEP 3: Reset and the warm canvas. */
* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  background-color: $cream;
  background-image: radial-gradient(circle at 12% 8%, rgba(246, 139, 30, 0.09), transparent 30%), radial-gradient(circle at 88% 18%, rgba(201, 151, 0, 0.08), transparent 28%);
  background-attachment: fixed;
  color: $ink;
  font-family: "Manrope", ui-sans-serif, system-ui, sans-serif;
  margin: 0;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input {
  font: inherit;
}

img,
svg {
  display: block;
}

::selection {
  background: rgba(246, 139, 30, 0.25);
  color: $ink;
}

:focus-visible {
  outline: 3px solid rgba(246, 139, 30, 0.6);
  outline-offset: 3px;
}

.sr-only {
  height: 1px;
  overflow: hidden;
  position: absolute;
  width: 1px;
}

/* STEP 4: Shared eyebrow and gradient text used on every route. */
.eyebrow {
  color: $accent-dark;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.22em;
  margin: 0;
  text-transform: uppercase;
}

.text-gold {
  background: linear-gradient(100deg, #f68b1e, #ffc63d 52%, #c99700);
  background-clip: text;
  -webkit-background-clip: text;
  color: transparent;
  -webkit-text-fill-color: transparent;
}

/* STEP 5: Sticky frosted navigation. */
.site-header {
  background: rgba(255, 255, 255, 0.82);
  border-bottom: 1px solid rgba(23, 23, 23, 0.06);
  position: sticky;
  top: 0;
  z-index: 50;
  backdrop-filter: blur(18px);
}

.nav {
  align-items: center;
  display: flex;
  height: 76px;
  justify-content: space-between;
  gap: 28px;
  margin: 0 auto;
  max-width: 1280px;
  padding: 0 40px;
}

.brand {
  align-items: center;
  display: inline-flex;
  font-family: "Playfair Display", Georgia, serif;
  font-size: 22px;
  font-weight: 700;
  gap: 10px;
  letter-spacing: -0.03em;
  white-space: nowrap;
}

.brand-mark {
  align-items: center;
  background: linear-gradient(135deg, $accent, $gold);
  border-radius: 12px;
  box-shadow: 0 12px 30px rgba(246, 139, 30, 0.28);
  color: $white;
  display: grid;
  font-family: "Manrope", sans-serif;
  font-size: 13px;
  font-weight: 800;
  height: 36px;
  justify-items: center;
  transition: transform 0.3s ease;
  width: 36px;
}

.brand:hover .brand-mark {
  transform: rotate(6deg) translateY(-2px);
}

.brand-dot {
  color: $accent!;
}

.nav-links {
  align-items: center;
  display: flex;
  gap: 34px;
  margin-left: auto;
}

.nav-links a {
  color: rgba(23, 23, 23, 0.58);
  font-size: 13px;
  font-weight: 700;
  transition: color 0.2s ease;
}

.nav-links a:hover {
  color: $accent-dark;
}

.nav-cta {
  align-items: center;
  background: $ink;
  border-radius: 999px;
  color: $white;
  display: inline-flex;
  font-size: 12px;
  font-weight: 800;
  gap: 6px;
  padding: 11px 20px;
  transition: background 0.2s ease, transform 0.2s ease;
  white-space: nowrap;
}

.nav-cta:hover {
  background: $accent;
  transform: translateY(-2px);
}

/* STEP 6: Hero layout, aura and editorial type. */
.hero {
  overflow: hidden;
  position: relative;
}

.hero-aura {
  background: radial-gradient(circle at 18% 12%, rgba(246, 139, 30, 0.18), transparent 34%), radial-gradient(circle at 86% 28%, rgba(201, 151, 0, 0.13), transparent 30%);
  inset: 0;
  pointer-events: none;
  position: absolute;
}

.hero-inner {
  align-items: center;
  display: grid;
  gap: 72px;
  grid-template-columns: 1.08fr 0.92fr;
  margin: 0 auto;
  max-width: 1280px;
  padding: 92px 40px 128px;
  position: relative;
}

.hero-copy {
  max-width: 680px;
}

.hero-badge {
  align-items: center;
  background: rgba(255, 255, 255, 0.78);
  border: 1px solid rgba(246, 139, 30, 0.22);
  border-radius: 999px;
  box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.7);
  color: $accent-dark;
  display: inline-flex;
  font-size: 10px;
  font-weight: 800;
  gap: 10px;
  letter-spacing: 0.18em;
  padding: 9px 16px;
  text-transform: uppercase;
  backdrop-filter: blur(12px);
}

.pulse-dot {
  background: $accent;
  border-radius: 50%;
  height: 8px;
  position: relative;
  width: 8px;
}

.pulse-dot::after {
  animation: ping-soft 2s ease-out infinite;
  border: 2px solid $accent;
  border-radius: 50%;
  content: "";
  inset: -4px;
  position: absolute;
}

@keyframes ping-soft {
  0% { opacity: 0.7; transform: scale(0.7); }
  80%, 100% { opacity: 0; transform: scale(1.7); }
}

.hero-title {
  font-family: "Playfair Display", Georgia, serif;
  font-size: clamp(3.2rem, 6.4vw, 6.6rem);
  font-weight: 600;
  letter-spacing: -0.045em;
  line-height: 0.94;
  margin: 30px 0 0;
}

.hero-lead {
  color: rgba(23, 23, 23, 0.6);
  font-size: 17px;
  line-height: 1.75;
  margin: 30px 0 0;
  max-width: 600px;
}

/* STEP 7: Search panel and category tags. */
.search-panel {
  align-items: center;
  background: $white;
  border: 1px solid rgba(23, 23, 23, 0.07);
  border-radius: 20px;
  box-shadow: var(--shadow-luxe);
  display: flex;
  gap: 12px;
  margin-top: 36px;
  max-width: 610px;
  padding: 10px;
  transition: border-color 0.25s ease, box-shadow 0.25s ease;
}

.search-panel:focus-within {
  border-color: rgba(246, 139, 30, 0.48);
  box-shadow: 0 0 0 5px rgba(246, 139, 30, 0.12), var(--shadow-luxe);
}

.search-field {
  align-items: center;
  display: flex;
  flex: 1;
  gap: 12px;
  min-width: 0;
  padding: 0 12px;
}

.search-icon {
  color: rgba(23, 23, 23, 0.3);
  height: 20px;
  flex: 0 0 20px;
  width: 20px;
}

.hero-input {
  background: transparent;
  border: 0;
  color: $ink;
  font-size: 14px;
  font-weight: 600;
  outline: none;
  padding: 12px 0;
  width: 100%;
}

.hero-input::placeholder {
  color: rgba(23, 23, 23, 0.35);
}

.quick-tags {
  align-items: center;
  color: rgba(23, 23, 23, 0.45);
  display: flex;
  flex-wrap: wrap;
  font-size: 12px;
  font-weight: 700;
  gap: 8px;
  margin-top: 16px;
}

.tag {
  background: rgba(255, 255, 255, 0.75);
  border: 1px solid rgba(23, 23, 23, 0.08);
  border-radius: 999px;
  color: rgba(23, 23, 23, 0.62);
  font-size: 11px;
  font-weight: 700;
  px: 13px;
  py: 7px;
  transition: border-color 0.2s ease, color 0.2s ease;
}

.tag:hover {
  border-color: rgba(246, 139, 30, 0.45);
  color: $accent-dark;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 34px;
}

/* STEP 8: Buttons are reused across every route. */
.btn {
  align-items: center;
  border-radius: 999px;
  display: inline-flex;
  font-size: 13px;
  fw: 800;
  gap: 8px;
  justify-content: center;
  padding: 14px 28px;
  transition: transform 0.22s ease, box-shadow 0.22s ease, background 0.22s ease, border-color 0.22s ease, color 0.22s ease;
}

.btn-primary {
  background: linear-gradient(120deg, $accent, #ffb13b);
  border: 0;
  box-shadow: 0 14px 34px rgba(246, 139, 30, 0.24);
  color: $white;
  cursor: pointer;
}

.btn-primary:hover {
  box-shadow: 0 20px 50px rgba(246, 139, 30, 0.34);
  transform: translateY(-2px);
}

.btn-secondary {
  background: $white;
  border: 1px solid rgba(23, 23, 23, 0.11);
  color: $ink;
}

.btn-secondary:hover {
  border-color: rgba(246, 139, 30, 0.5);
  color: $accent-dark;
  transform: translateY(-2px);
}

.btn-block {
  margin-top: 24px;
  width: 100%;
}

/* STEP 9: Hero proof stats. */
.proof {
  border-top: 1px solid rgba(23, 23, 23, 0.09);
  display: flex;
  flex-wrap: wrap;
  gap: 18px 42px;
  margin-top: 44px;
  padding-top: 28px;
}

.proof-item {
  display: flex;
  flex-direction: column;
}

.proof-value {
  font-family: "Playfair Display", Georgia, serif;
  font-size: 32px;
  font-weight: 600;
  letter-spacing: -0.03em;
  line-height: 1;
}

.proof-label {
  color: rgba(23, 23, 23, 0.45);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.14em;
  margin-top: 8px;
  text-transform: uppercase;
}

/* STEP 10: Floating listing preview built entirely in CSS. */
.preview-stage {
  margin: 0 auto;
  max-width: 520px;
  position: relative;
  width: 100%;
}

.float-badge {
  align-items: center;
  animation: luxe-float 5s ease-in-out infinite;
  background: rgba(255, 255, 255, 0.92);
  border: 1px solid rgba(23, 23, 23, 0.07);
  border-radius: 999px;
  box-shadow: var(--shadow-float);
  color: $ink;
  display: none;
  font-size: 11px;
  font-weight: 800;
  gap: 9px;
  padding: 11px 17px;
  position: absolute;
  z-index: 20;
  backdrop-filter: blur(14px);
}

.float-one { left: -26px; top: 52px; }
.float-two { bottom: 168px; right: -18px; }
.float-three { bottom: -22px; left: 44px; }

.badge-dot {
  background: $accent!;
  border-radius: 50%;
  height: 8px;
  width: 8px;
}

.gold-dot {
  background: $gold!;
}

.spark {
  color: $accent-dark;
  font-family: "Playfair Display", Georgia, serif;
  font-size: 16px;
}

@keyframes luxe-float {
  0%, 100% { translate: 0 0; }
  50% { translate: 0 -8px; }
}

.listing-card {
  background: rgba(255, 255, 255, 0.86);
  border: 1px solid rgba(255, 255, 255, 0.9);
  border-radius: 34px;
  box-shadow: var(--shadow-luxe);
  padding: 16px;
  position: relative;
  backdrop-filter: blur(18px);
}

.mock-art {
  background: linear-gradient(135deg, #262626, #454545 45%, #111111);
  border-radius: 26px;
  height: 224px;
  overflow: hidden;
  position: relative;
}

.mock-art::before {
  background-image: linear-gradient(rgba(255, 255, 255, 0.055) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, 0.055) 1px, transparent 1px);
  background-size: 32px 32px;
  content: "";
  inset: 0;
  position: absolute;
}

.art-shine {
  animation: art-shine 5.5s ease-in-out infinite;
  background: linear-gradient(120deg, transparent 38%, rgba(255, 255, 255, 0.3) 50%, transparent 62%);
  inset: -20%;
  position: absolute;
  transform: translateX(-60%) rotate(8deg);
}

@keyframes art-shine {
  0%, 25% { transform: translateX(-70%) rotate(8deg); }
  65%, 100% { transform: translateX(70%) rotate(8deg); }
}

.laptop {
  background: rgba(255, 255, 255, 0.11);
  border: 1px solid rgba(255, 255, 255, 0.22);
  border-radius: 12px;
  box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
  height: 112px;
  left: 50%;
  position: absolute;
  top: 46%;
  transform: translate(-50%, -50%);
  width: 176px;
  backdrop-filter: blur(6px);
}

.laptop::after {
  background: rgba(255, 255, 255, 0.09);
  border-radius: 0 0 12px 12px;
  bottom: -10px;
  content: "";
  height: 10px;
  left: 8%;
  position: absolute;
  width: 84%;
}

.art-caption {
  align-items: flex-end;
  bottom: 20px;
  display: flex;
  justify-content: space-between;
  left: 24px;
  position: absolute;
  right: 24px;
}

.art-wordmark {
  color: rgba(255, 255, 255, 0.82);
  font-family: "Playfair Display", Georgia, serif;
  font-size: 46px;
  font-weight: 600;
  letter-spacing: -0.05em;
  line-height: 1;
}

.art-tag {
  background: rgba(255, 255, 255, 0.12);
  border: 1px solid rgba(255, 255, 255, 0.22);
  border-radius: 999px;
  color: rgba(255, 255, 255, 0.75);
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.14em;
  padding: 7px 12px;
  text-transform: uppercase;
  backdrop-filter: blur(10px);
}

.listing-body {
  padding: 24px 8px 8px;
}

.listing-top {
  align-items: center;
  display: flex;
  justify-content: space-between;
  gap: 12px;
}

.badge-soft {
  background: $accent-soft;
  border-radius: 999px;
  color: $accent-dark;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.16em;
  padding: 7px 12px;
  text-transform: uppercase;
}

.listing-meta {
  color: rgba(23, 23, 23, 0.4);
  font-size: 11px;
  font-weight: 700;
}

.listing-title {
  font-family: "Playfair Display", Georgia, serif;
  font-size: 24px;
  font-weight: 600;
  letter-spacing: -0.025em;
  margin: 18px 0 0;
}

.price {
  color: $accent-dark;
  font-family: "Playfair Display", Georgia, serif;
  font-size: 30px;
  font-weight: 600;
  margin: 8px 0 0;
}

.seller {
  align-items: center;
  border-top: 1px solid rgba(23, 23, 23, 0.08);
  display: flex;
  gap: 12px;
  margin-top: 22px;
  padding-top: 20px;
}

.avatar {
  align-items: center;
  background: $ink;
  border-radius: 50%;
  color: $white;
  display: grid;
  font-size: 11px;
  font-weight: 800;
  height: 38px;
  justify-items: center;
  width: 38px;
}

.seller-copy {
  display: flex;
  flex-direction: column;
}

.seller-name {
  font-size: 13px;
  font-weight: 700;
}

.seller-sub {
  color: rgba(23, 23, 23, 0.42);
  font-size: 11px;
}

/* STEP 11: Trust strip. */
.trust-strip {
  background: rgba(255, 255, 255, 0.72);
  border-bottom: 1px solid rgba(23, 23, 23, 0.06);
  border-top: 1px solid rgba(23, 23, 23, 0.06);
  backdrop-filter: blur(14px);
}

.trust-inner {
  align-items: center;
  display: flex;
  flex-wrap: wrap;
  gap: 20px 32px;
  justify-content: space-between;
  margin: 0 auto;
  max-width: 1280px;
  padding: 30px 40px;
}

.trust-label {
  color: rgba(23, 23, 23, 0.42);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.2em;
  margin: 0;
  text-transform: uppercase;
}

.trust-points {
  display: flex;
  flex-wrap: wrap;
  gap: 14px 38px;
}

.trust-points span {
  color: rgba(23, 23, 23, 0.62);
  font-size: 13px;
  font-weight: 700;
}

/* STEP 12: Generic section shells and headings. */
.section {
  margin: 0 auto;
  max-width: 1280px;
  padding: 112px 40px;
}

.section-soft {
  background: rgba(255, 255, 255, 0.62);
  border-bottom: 1px solid rgba(23, 23, 23, 0.05);
  border-top: 1px solid rgba(23, 23, 23, 0.05);
}

.section-head {
  margin-bottom: 46px;
  max-width: 760px;
}

.section-head-row {
  align-items: flex-end;
  display: flex;
  flex-wrap: wrap;
  gap: 28px;
  justify-content: space-between;
}

.section-head-row .section-head {
  margin-bottom: 0;
}

.section-title {
  font-family: "Playfair Display", Georgia, serif;
  font-size: clamp(2.4rem, 5vw, 4.4rem);
  font-weight: 600;
  letter-spacing: -0.04em;
  line-height: 1.04;
  margin: 18px 0 0;
}

.section-lead {
  color: rgba(23, 23, 23, 0.56);
  font-size: 16px;
  line-height: 1.75;
  margin: 22px 0 0;
  max-width: 620px;
}

.section-note {
  color: rgba(23, 23, 23, 0.5);
  font-size: 13px;
  line-height: 1.7;
  margin: 0;
  max-width: 300px;
}

/* STEP 13: Premium cards with a gold reveal line. */
.card-grid,
.category-grid,
.audience-grid,
.scope-grid {
  display: grid;
  gap: 20px;
}

.card-grid,
.audience-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.category-grid,
.scope-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.premium-card,
.category-card,
.audience-card {
  background: rgba(255, 255, 255, 0.95);
  border: 1px solid rgba(23, 23, 23, 0.06);
  border-radius: 28px;
  box-shadow: 0 18px 50px rgba(23, 23, 23, 0.065);
  overflow: hidden;
  padding: 34px;
  position: relative;
  transition: border-color 0.28s ease, box-shadow 0.28s ease, transform 0.28s ease;
}

.premium-card::before,
.category-card::before,
.audience-card::before {
  background: linear-gradient(90deg, $accent, $gold);
  content: "";
  height: 3px;
  left: 0;
  position: absolute;
  top: 0;
  transition: width 0.35s ease;
  width: 0;
}

.premium-card:hover,
.category-card:hover,
.audience-card:hover {
  border-color: rgba(246, 139, 30, 0.35);
  box-shadow: 0 28px 70px rgba(23, 23, 23, 0.12);
  transform: translateY(-4px);
}

.premium-card:hover::before,
.category-card:hover::before,
.audience-card:hover::before {
  width: 100%;
}

.card-index {
  color: rgba(246, 139, 30, 0.82);
  font-family: "Playfair Display", Georgia, serif;
  font-size: 40px;
  font-weight: 600;
  line-height: 1;
}

.card-title,
.category-title,
.audience-title {
  font-family: "Playfair Display", Georgia, serif;
  font-size: 21px;
  font-weight: 600;
  letter-spacing: -0.02em;
  margin: 26px 0 0;
}

.card-copy,
.category-copy,
.audience-copy {
  color: rgba(23, 23, 23, 0.56);
  font-size: 13px;
  line-height: 1.7;
  margin: 10px 0 0;
}

/* STEP 14: Category tiles with distinct gradient chips. */
.category-card {
  padding: 30px;
}

.category-icon {
  align-items: center;
  border-radius: 18px;
  color: $white;
  display: grid;
  font-size: 11px;
  font-weight: 800;
  height: 52px;
  justify-items: center;
  letter-spacing: 0.06em;
  width: 52px;
}

.cat-one { background: linear-gradient(135deg, #7c5cff, #4f35c7); }
.cat-two { background: linear-gradient(135deg, #1d9bf0, #0066c2); }
.cat-three { background: linear-gradient(135deg, #ef476f, #b51e48); }
.cat-four { background: linear-gradient(135deg, #118ab2, #075d7d); }
.cat-five { background: linear-gradient(135deg, #f78c6b, #d55f3c); }
.cat-six { background: linear-gradient(135deg, #06d6a0, #049e76); }

.category-title {
  font-size: 20px;
  margin-top: 26px;
}

.category-link {
  color: $accent-dark;
  display: inline-block;
  font-size: 11px;
  font-weight: 800;
  margin-top: 22px;
  opacity: 0;
  transform: translateY(6px);
  transition: opacity 0.25s ease, transform 0.25s ease;
}

.category-card:hover .category-link {
  opacity: 1;
  transform: translateY(0);
}

/* STEP 15: How-it-works split and dark MVP card. */
.split {
  align-items: start;
  display: grid;
  gap: 72px;
  grid-template-columns: 1.12fr 0.88fr;
}

.steps {
  list-style: none;
  margin: 48px 0 0;
  padding: 0;
}

.step {
  display: flex;
  gap: 20px;
  margin-bottom: 36px;
}

.step-num {
  align-items: center;
  background: $accent-soft;
  border-radius: 50%;
  color: $accent-dark;
  display: grid;
  flex: 0 0 42px;
  font-size: 13px;
  font-weight: 800;
  height: 42px;
  justify-items: center;
}

.step-title {
  font-family: "Playfair Display", Georgia, serif;
  font-size: 19px;
  font-weight: 600;
  margin: 0;
}

.step-copy {
  color: rgba(23, 23, 23, 0.55);
  font-size: 13px;
  line-height: 1.7;
  margin: 8px 0 0;
}

.flow-card {
  background: $ink;
  border-radius: 34px;
  box-shadow: var(--shadow-luxe);
  color: $white;
  overflow: hidden;
  padding: 42px;
  position: sticky;
  top: 112px;
}

.flow-glow {
  background: radial-gradient(circle, rgba(246, 139, 30, 0.42), transparent 68%);
  border-radius: 50%;
  height: 240px;
  position: absolute;
  right: -90px;
  top: -90px;
  width: 240px;
}

.flow-label {
  color: $accent;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.22em;
  margin: 0;
  text-transform: uppercase;
}

.flow-title {
  font-family: "Playfair Display", Georgia, serif;
  font-size: 30px;
  font-weight: 600;
  letter-spacing: -0.03em;
  line-height: 1.18;
  margin: 24px 0 0;
  position: relative;
}

.flow-copy {
  color: rgba(255, 255, 255, 0.62);
  font-size: 13px;
  line-height: 1.75;
  margin: 20px 0 0;
  position: relative;
}

.flow-action {
  margin-top: 32px;
  position: relative;
}

/* STEP 16: Audience cards. */
.audience-card {
  padding: 36px;
}

.audience-label {
  color: $accent-dark;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.2em;
  margin: 0;
  text-transform: uppercase;
}

.audience-title {
  font-size: 26px;
}

.gold-rule {
  background: linear-gradient(90deg, $accent, $gold);
  border-radius: 999px;
  display: block;
  height: 4px;
  margin-top: 34px;
  width: 52px;
}

/* STEP 17: Warm closing CTA. */
.cta {
  background: var(--gradient-gold);
  color: $white;
  overflow: hidden;
  padding: 120px 40px;
  position: relative;
}

.cta-aura {
  background: radial-gradient(circle at 20% 20%, rgba(255, 255, 255, 0.45), transparent 28%), radial-gradient(circle at 82% 80%, rgba(255, 255, 255, 0.35), transparent 24%);
  inset: 0;
  opacity: 0.35;
  pointer-events: none;
  position: absolute;
}

.cta-inner {
  margin: 0 auto;
  max-width: 860px;
  position: relative;
  text-align: center;
}

.cta-label {
  color: rgba(255, 255, 255, 0.78);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.24em;
  margin: 0;
  text-transform: uppercase;
}

.cta-title {
  font-family: "Playfair Display", Georgia, serif;
  font-size: clamp(2.6rem, 6vw, 5rem);
  font-weight: 600;
  letter-spacing: -0.04em;
  line-height: 1.02;
  margin: 26px 0 0;
}

.cta-copy {
  color: rgba(255, 255, 255, 0.84);
  font-size: 16px;
  line-height: 1.75;
  margin: 24px auto 0;
  max-width: 620px;
}

.cta-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  justify-content: center;
  margin-top: 44px;
}

.cta-light,
.cta-ghost {
  border-radius: 999px;
  display: inline-flex;
  font-size: 13px;
  font-weight: 800;
  padding: 14px 30px;
  transition: transform 0.22s ease, background 0.22s ease;
}

.cta-light {
  background: $white;
  box-shadow: var(--shadow-float);
  color: $accent-dark;
}

.cta-ghost {
  border: 1px solid rgba(255, 255, 255, 0.6);
  color: $white;
}

.cta-light:hover,
.cta-ghost:hover {
  transform: translateY(-2px);
}

.cta-ghost:hover {
  background: rgba(255, 255, 255, 0.12);
}

/* STEP 18: Shared footer. */
.site-footer {
  background: $white;
  border-top: 1px solid rgba(23, 23, 23, 0.06);
}

.footer-grid {
  display: grid;
  gap: 48px;
  grid-template-columns: 1.5fr 1fr 1fr;
  margin: 0 auto;
  max-width: 1280px;
  padding: 72px 40px;
}

.footer-brand-block p {
  color: rgba(23, 23, 23, 0.55);
  font-size: 13px;
  line-height: 1.7;
  margin: 18px 0 0;
  max-width: 380px;
}

.footer-title {
  color: rgba(23, 23, 23, 0.4);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.22em;
  margin: 8px 0 0;
  text-transform: uppercase;
}

.footer-links {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-top: 18px;
}

.footer-links a {
  color: rgba(23, 23, 23, 0.65);
  font-size: 13px;
  font-weight: 700;
  transition: color 0.2s ease;
}

.footer-links a:hover {
  color: $accent-dark;
}

.footer-note {
  border-top: 1px solid rgba(23, 23, 23, 0.06);
  color: rgba(23, 23, 23, 0.42);
  font-size: 11px;
  padding: 24px 40px;
  text-align: center;
}

/* STEP 19: About page hero and scope grid. */
.page-hero {
  border-bottom: 1px solid rgba(23, 23, 23, 0.06);
  overflow: hidden;
  position: relative;
}

.page-hero-aura {
  background: radial-gradient(circle, rgba(246, 139, 30, 0.2), transparent 68%);
  border-radius: 50%;
  height: 420px;
  pointer-events: none;
  position: absolute;
  right: -120px;
  top: -150px;
  width: 420px;
}

.page-hero-inner {
  margin: 0 auto;
  max-width: 1280px;
  padding: 120px 40px;
  position: relative;
}

.page-title {
  font-family: "Playfair Display", Georgia, serif;
  font-size: clamp(2.8rem, 6vw, 5.5rem);
  font-weight: 600;
  letter-spacing: -0.045em;
  line-height: 1.02;
  margin: 24px 0 0;
  max-width: 980px;
}

.page-lead {
  color: rgba(23, 23, 23, 0.56);
  font-size: 17px;
  line-height: 1.75;
  margin: 30px 0 0;
  max-width: 640px;
}

.scope-card {
  padding: 30px;
}

.scope-card .card-index {
  font-size: 32px;
}

/* STEP 20: 404 page. */
.error-page {
  min-height: 70vh;
  overflow: hidden;
  position: relative;
}

.error-aura {
  background: radial-gradient(circle at 50% 28%, rgba(246, 139, 30, 0.18), transparent 36%);
  inset: 0;
  pointer-events: none;
  position: absolute;
}

.error-inner {
  margin: 0 auto;
  max-width: 1280px;
  padding: 140px 40px;
  position: relative;
  text-align: center;
}

.error-title {
  font-family: "Playfair Display", Georgia, serif;
  font-size: clamp(3rem, 7vw, 6rem);
  font-weight: 600;
  letter-spacing: -0.045em;
  line-height: 1.02;
  margin: 26px 0 0;
}

.error-copy {
  color: rgba(23, 23, 23, 0.55);
  font-size: 15px;
  line-height: 1.75;
  margin: 24px auto 0;
  max-width: 560px;
}

.error-action {
  margin-top: 40px;
}

/* STEP 21: Tablet layout keeps the hierarchy but relaxes the grid. */
@media (max-width: 1100px) {
  .hero-inner,
  .split {
    grid-template-columns: 1fr;
  }

  .hero-inner {
    gap: 60px;
    padding-top: 76px;
  }

  .hero-copy {
    max-width: 780px;
  }

  .preview-stage {
    max-width: 560px;
  }

  .flow-card {
    position: static;
  }

  .card-grid,
  .category-grid,
  .audience-grid,
  .scope-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

/* STEP 22: Mobile layout swaps grids for stacked reading. */
@media (max-width: 760px) {
  .nav {
    height: 68px;
    padding: 0 22px;
  }

  .nav-links {
    display: none;
  }

  .nav-cta {
    margin-left: auto;
    padding: 10px 16px;
  }

  .hero-inner {
    gap: 48px;
    padding: 72px 22px 96px;
  }

  .hero-title {
    font-size: clamp(2.8rem, 12vw, 4.4rem);
  }

  .hero-lead {
    font-size: 15px;
  }

  .search-panel {
    align-items: stretch;
    flex-direction: column;
  }

  .search-field {
    padding: 0 6px;
  }

  .search-panel .btn {
    width: 100%;
  }

  .float-badge {
    display: none;
  }

  .trust-inner {
    align-items: flex-start;
    flex-direction: column;
    padding: 26px 22px;
  }

  .trust-points {
    gap: 10px 24px;
  }

  .section {
    padding: 84px 22px;
  }

  .section-title {
    font-size: clamp(2.2rem, 9vw, 3.4rem);
  }

  .card-grid,
  .category-grid,
  .audience-grid,
  .scope-grid {
    grid-template-columns: 1fr;
  }

  .premium-card,
  .category-card,
  .audience-card,
  .scope-card {
    padding: 28px;
  }

  .split {
    gap: 44px;
  }

  .flow-card {
    border-radius: 28px;
    padding: 30px;
  }

  .cta {
    padding: 92px 22px;
  }

  .cta-actions {
    flex-direction: column;
  }

  .cta-actions a {
    width: 100%;
  }

  .footer-grid {
    grid-template-columns: 1fr;
    gap: 36px;
    padding: 56px 22px;
  }

  .footer-note {
    padding: 22px;
  }

  .page-hero-inner,
  .error-inner {
    padding: 92px 22px;
  }
}

/* STEP 23: Very small screens get full-width buttons and tighter proof spacing. */
@media (max-width: 420px) {
  .hero-actions .btn {
    width: 100%;
  }

  .proof {
    gap: 20px 28px;
  }

  .proof-value {
    font-size: 28px;
  }

  .art-wordmark {
    font-size: 38px;
  }

  .brand {
    font-size: 19px;
  }
}

/* STEP 24: Kill decorative movement for users who ask for less motion. */
@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  .float-badge,
  .pulse-dot::after,
  .art-shine {
    animation: none;
  }

  .brand-mark,
  .nav-cta,
  .nav-links a,
  .btn,
  .tag,
  .search-panel,
  .premium-card,
  .category-card,
  .audience-card,
  .category-link,
  .cta-light,
  .cta-ghost {
    transition: none;
  }

  .brand:hover .brand-mark,
  .nav-cta:hover,
  .btn:hover,
  .premium-card:hover,
  .category-card:hover,
  .audience-card:hover,
  .cta-light:hover,
  .cta-ghost:hover {
    transform: none;
  }
}

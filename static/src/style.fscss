$accent: #8f6bff;
$ink: #0b0a13;
$surface: #151322;
$muted: #a7a3bb;

:root {
  --accent: $accent!;
}

* {
  box-sizing: border-box;
}

body {
  bg: $ink!;
  color: #f7f5ff;
  ff: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  margin: 0;
  line-height: 1.6;
}

a {
  color: inherit;
  text-decoration: none;
}

.site-header {
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  padding: 18px 0;
}

.nav {
  align-items: center;
  display: flex;
  gap: 24px;
  justify-content: space-between;
  margin: 0 auto;
  max-width: 1120px;
  padding: 0 4vw;
}

.brand {
  font-size: 20px;
  font-weight: 800;
  letter-spacing: -0.04em;
}

.brand span {
  color: var(--accent);
}

.nav-links {
  color: $muted!;
  display: flex;
  font-size: 14px;
  gap: 22px;
}

.nav-links a:hover {
  color: #fff;
}

.container {
  margin: 0 auto;
  max-width: 1120px;
  padding: 0 4vw 64px;
}

.hero {
  max-width: 780px;
  padding: 72px 0 48px;
}

.eyebrow {
  color: var(--accent);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.22em;
  margin: 0;
  text-transform: uppercase;
}

.hero h1 {
  font-size: clamp(40px, 7vw, 76px);
  letter-spacing: -0.05em;
  line-height: 1.02;
  margin: 16px 0;
}

.gradient {
  background: linear-gradient(100deg, #c4b5fd, #67e8f9);
  background-clip: text;
  -webkit-background-clip: text;
  color: transparent;
}

.lead {
  color: $muted!;
  font-size: 18px;
  margin: 0;
  max-width: 620px;
}

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 28px;
}

.btn {
  align-items: center;
  bg: $accent!;
  color: #fff;
  display: inline-flex;
  fw: 700;
  gap: 8px;
  px: 20px;
  py: 12px;
  rounded: 12px;
}

.btn.secondary {
  bg: #221f33;
  color: #fff;
}

.card-grid {
  display: grid;
  gap: 16px;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
}

.card {
  bg: $surface!;
  border: 1px solid rgba(255, 255, 255, 0.07);
  px: 24px;
  py: 22px;
  rounded: 18px;
  stack: 8px;
}

.card h2 {
  font-size: 18px;
  margin: 0;
}

.card p {
  color: $muted!;
  font-size: 14px;
  margin: 0;
}

code {
  background: rgba(143, 107, 255, 0.14);
  border-radius: 6px;
  color: #ddd6fe;
  font-size: 0.9em;
  padding: 2px 6px;
}

.status {
  align-items: center;
  bg: #12251d;
  color: #86efac;
  display: inline-flex;
  font-size: 13px;
  fw: 700;
  gap: 8px;
  margin-top: 32px;
  px: 14px;
  py: 8px;
  rounded: 999px;
}

.dot {
  bg: #4ade80;
  border-radius: 50%;
  height: 8px;
  width: 8px;
}

.site-footer {
  border-top: 1px solid rgba(255, 255, 255, 0.08);
  color: $muted!;
  font-size: 13px;
  padding: 24px 0;
  text-align: center;
}

@media (prefers-reduced-motion: no-preference) {
  .btn {
    transition: transform 0.2s ease, filter 0.2s ease;
  }

  .btn:hover {
    filter: brightness(1.08);
    transform: translateY(-2px);
  }
}
